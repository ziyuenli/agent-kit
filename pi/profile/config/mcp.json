{
  "mcpServers": {
    "zotero": {
      "command": "npx",
      "args": [
        "-y",
        "@oscardvs/zoteus@1.12.0"
      ],
      "env": {
        "ZOTEUS_LOCAL": "on",
        "ZOTEUS_EMBEDDINGS": "off",
        "ZOTEUS_INDEX_FULLTEXT": "false",
        "ZOTEUS_ALLOW_DELETE": "false"
      },
      "lifecycle": "lazy",
      "directTools": false,
      "idleTimeout": 10
    }
  }
}
